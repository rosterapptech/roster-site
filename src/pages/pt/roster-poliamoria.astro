---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Vio from '../../components/Vio.astro';
import { ROSTER_POLY_SLUG, rosterPolyPath } from '../../i18n/rosterPolyPath';
import { slugAlternates } from '../../i18n/slugAlternates';
import { rosterPolyBreadcrumb } from '../../i18n/breadcrumbs';
import { quizPath } from '../../i18n/quizPath';

const lang = 'pt';
const APP_STORE_URL = 'https://apps.apple.com/app/roster-polyamory-tracker/id6786782804';

const highlights = [
  { slug: 'polycule-map', name: 'Polycule Map', desc: 'Sua rede de relacionamentos como um mapa vivo, não uma lista mental – você no centro, cada conexão colorida por tipo.' },
  { slug: 'wellness', name: 'Wellness', desc: 'Testes de ISTs e check-ins à vista, discretos e locais – importante assim que mais de duas pessoas estão envolvidas.' },
  { slug: 'reflection', name: 'Reflexão', desc: 'Um diário para ciúmes, compersão e NRE. Para organizar seus sentimentos, não julgá-los.' },
  { slug: 'vio', name: 'Vio', vio: true, desc: 'Sua companhia dentro do app que pergunta como você está – às vezes suave, às vezes direto ao ponto.' },
];

const related = [
  { title: 'O que é poliamoria? Significado, definição e o essencial', href: '/pt/blog/o-que-e-poliamoria/' },
  { title: 'Não monogamia ética: definição, formas e diferenças', href: '/pt/blog/nao-monogamia-etica/' },
  { title: 'Poliamoria para iniciantes: um começo honesto', href: '/pt/blog/poliamoria-para-iniciantes/' },
  { title: 'O que é um polycule? Formas de relacionamento e exemplos', href: '/pt/blog/o-que-e-um-polycule/' },
  { title: 'Metamour, compersão, NRE e mais – o glossário completo', href: '/pt/blog/glossario-poliamoria/' },
];

const faqs = [
  {
    q: 'O Roster é só para poliamoria, ou também para não monogamia ética, relacionamentos abertos e anarquia relacional?',
    a: 'O Roster foi feito para qualquer forma de não monogamia ética – poliamoria clássica, hierárquica ou não hierárquica, poliamoria solo, relacionamento aberto ou anarquia relacional. O app não impõe uma estrutura, ele reflete a que seus relacionamentos já têm.',
  },
  {
    q: 'Qual a diferença entre o Roster e um app de namoro como o Feeld?',
    a: 'Apps de namoro ajudam você a conhecer pessoas novas. O Roster começa onde isso termina: ajuda você a cuidar dos relacionamentos que já tem – com visão geral, check-ins e reflexão em vez de deslizar perfis.',
  },
  {
    q: 'Meus dados são privados?',
    a: 'Sim. O Roster é local-first: todos os dados ficam no seu dispositivo. Não há backend do Roster, nem rastreamento, nem sincronização na nuvem que guarde seus dados de relacionamento em outro lugar.',
  },
  {
    q: 'Quanto custa o Roster?',
    a: 'As funções básicas são gratuitas. O Premium custa 0,99 €/semana, 2,99 €/mês (com 3 dias grátis) ou 29,90 €/ano.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    rosterPolyBreadcrumb(lang, 'Roster Poliamoria', Astro.site!),
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
---

<BaseLayout
  lang={lang}
  path={`/${ROSTER_POLY_SLUG.pt}`}
  alternates={slugAlternates(rosterPolyPath, Astro.site!)}
  title="Roster Poliamoria – o app para todos os seus relacionamentos"
  description="Roster Poliamoria: o app de relacionamentos para quem vive mais de um relacionamento com consciência – local, sem conta, sem rastreamento."
  schema={schema}
>
  <Header lang={lang} />
  <main class="rp-page">
    <section class="hero">
      <div class="container">
        <p class="eyebrow">Privacy-First · iOS</p>
        <h1>Roster Poliamoria</h1>
        <p class="lede">
          O app para quem vive conscientemente mais de um relacionamento ao mesmo tempo –
          poliamoria clássica, hierárquica, solo-poli ou anarquia relacional. Dados locais,
          sem conta, sem rastreamento.
        </p>
        <div class="hero-cta">
          <a href={APP_STORE_URL} class="btn btn-primary" rel="noopener">Baixar na App Store</a>
          <a href={quizPath(lang)} class="btn btn-ghost">Fazer o teste de compatibilidade</a>
        </div>
      </div>
    </section>

    <section class="why">
      <div class="container why-grid">
        <div>
          <p class="eyebrow">Não é um app de namoro</p>
          <h2>O Roster não ajuda a encontrar, ajuda a cuidar.</h2>
        </div>
        <div class="why-text">
          <p>
            Feeld, helloPOLY e outros são bons para encontrar pessoas novas. Mas quando você
            já está cuidando de vários relacionamentos de verdade, precisa de outra coisa: um
            lugar para conexões, check-ins e os sentimentos no meio do caminho – sem parecer
            uma ferramenta de gestão de projetos.
          </p>
          <p>
            É aí que o Roster entra. Leia uma <a href="/pt/blog/app-para-organizar-relacionamentos-poliamorosos/">comparação honesta de como o Roster se diferencia dos apps de namoro puros</a> no blog.
          </p>
        </div>
      </div>
    </section>

    <section class="highlights">
      <div class="container">
        <p class="eyebrow">O que está incluído</p>
        <h2>Feito para a poliamoria de verdade, não para a teoria.</h2>
        <div class="grid">
          {highlights.map((h) => (
            <a href={`/pt/features/${h.slug}/`} class="card highlight">
              {h.vio ? <Vio size={30} /> : <span class="dot" />}
              <h3>{h.name}</h3>
              <p>{h.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="shapes">
      <div class="container">
        <p class="eyebrow">Para toda forma de não monogamia ética</p>
        <h2>Poliamoria não é um modelo único.</h2>
        <p class="lede" style="margin-bottom:32px">
          Não monogamia ética é o termo guarda-chuva – poliamoria, relacionamentos abertos,
          anarquia relacional e poliamoria solo são todas formas dela. O Roster se adapta à
          sua forma, não o contrário.
        </p>
        <ul class="related-list">
          {related.map((r) => (
            <li><a href={r.href}>{r.title} →</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section id="faq" class="faq">
      <div class="container faq-wrap">
        <div><p class="eyebrow">FAQ</p><h2>Perguntas frequentes</h2></div>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="card faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="closing">
      <div class="container closing-inner">
        <Vio size={48} />
        <h2>Roster Poliamoria – pronto para clarear a mente?</h2>
        <a href={APP_STORE_URL} class="btn btn-primary" rel="noopener">Baixar o Roster na App Store</a>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .hero { padding-top: clamp(48px, 7vw, 88px); padding-bottom: clamp(32px, 5vw, 56px); text-align: center; }
  .hero .lede { max-width: 56ch; margin-inline: auto; }
  .hero-cta { display: flex; gap: 14px; margin-top: 32px; flex-wrap: wrap; justify-content: center; }
  .why-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 40px; align-items: start; }
  .why-text p { color: var(--text-muted); line-height: 1.75; }
  .why-text a { color: var(--purple); }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 40px; }
  .highlight { color: var(--text); text-decoration: none; transition: border-color 0.2s ease, transform 0.15s ease; }
  .highlight:hover { text-decoration: none; border-color: var(--purple); transform: translateY(-3px); }
  .highlight .dot { display: block; width: 10px; height: 10px; border-radius: 50%; background: var(--purple); }
  .highlight h3 { margin-top: 16px; }
  .highlight p { color: var(--text-muted); margin: 0; font-size: 0.92rem; }
  .related-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .related-list a { display: block; padding: 16px 0; border-bottom: 1px solid var(--border); color: var(--text); font-size: 1rem; }
  .related-list a:hover { color: var(--purple); text-decoration: none; }
  .faq-wrap { display: grid; grid-template-columns: 0.6fr 1.4fr; gap: 40px; align-items: start; }
  .faq-list { display: flex; flex-direction: column; gap: 12px; }
  .faq-item { padding: 0; }
  .faq-item summary { cursor: pointer; list-style: none; padding: 20px 24px; font-weight: 500; display: flex; justify-content: space-between; align-items: center; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; color: var(--purple); font-size: 1.4rem; line-height: 1; }
  .faq-item[open] summary::after { content: '–'; }
  .faq-item p { padding: 0 24px 22px; margin: 0; color: var(--text-muted); }
  .closing-inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .closing h2 { max-width: 20ch; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .why-grid { grid-template-columns: 1fr; }
    .faq-wrap { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
