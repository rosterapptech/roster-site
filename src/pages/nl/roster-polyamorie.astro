---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Vio from '../../components/Vio.astro';
import { ROSTER_POLY_SLUG, rosterPolyPath } from '../../i18n/rosterPolyPath';
import { slugAlternates } from '../../i18n/slugAlternates';
import { rosterPolyBreadcrumb } from '../../i18n/breadcrumbs';
import { quizPath } from '../../i18n/quizPath';

const lang = 'nl';
const APP_STORE_URL = 'https://apps.apple.com/app/roster-polyamory-tracker/id6786782804';

const highlights = [
  { slug: 'polycule-map', name: 'Polycule Map', desc: 'Je relatienetwerk als levende kaart in plaats van een lijstje in je hoofd – jij in het midden, elke verbinding gekleurd naar type.' },
  { slug: 'wellness', name: 'Wellness', desc: 'SOA-testen en check-ins in beeld, discreet en lokaal – belangrijk zodra er meer dan twee mensen bij betrokken zijn.' },
  { slug: 'reflection', name: 'Reflectie', desc: 'Een dagboek voor jaloezie, compersion en NRE. Om je gevoelens te ordenen, niet te beoordelen.' },
  { slug: 'vio', name: 'Vio', vio: true, desc: 'Je metgezel in de app die vraagt hoe het met je gaat – soms zacht, soms eerlijk zonder omwegen.' },
];

const related = [
  { title: 'Wat is polyamorie? Betekenis, definitie en de basis', href: '/nl/blog/wat-is-polyamorie/' },
  { title: 'Ethische non-monogamie (ENM): definitie, vormen en verschillen', href: '/nl/blog/ethische-non-monogamie/' },
  { title: 'Polyamorie voor beginners: de eerlijke start', href: '/nl/blog/polyamorie-voor-beginners/' },
  { title: 'Wat is een polycule? Relatievormen en voorbeelden', href: '/nl/blog/wat-is-een-polycule/' },
  { title: 'Metamour, compersion, NRE & meer – de complete woordenlijst', href: '/nl/blog/polyamorie-woordenlijst/' },
];

const faqs = [
  {
    q: 'Is Roster alleen voor polyamorie, of ook voor ENM, open relaties en relatieanarchie?',
    a: 'Roster is gebouwd voor elke vorm van ethische non-monogamie – klassiek polyamoor, hiërarchisch of niet-hiërarchisch, solo-poly, open relatie of relatieanarchie. De app legt geen structuur op, hij weerspiegelt de structuur die jouw relaties al hebben.',
  },
  {
    q: 'Hoe verschilt Roster van een datingapp zoals Feeld?',
    a: 'Datingapps helpen je nieuwe mensen vinden. Roster begint waar dat ophoudt: het helpt je de relaties te beheren die je al hebt – met overzicht, check-ins en reflectie in plaats van swipen.',
  },
  {
    q: 'Zijn mijn gegevens privé?',
    a: 'Ja. Roster is local-first: alle data blijft op je apparaat. Er is geen Roster-backend, geen tracking en geen cloudsynchronisatie die je relatiegegevens ergens anders opslaat.',
  },
  {
    q: 'Wat kost Roster?',
    a: 'De basis is gratis. Premium kost €0,99 per week, €2,99 per maand (met 3 dagen gratis) of €29,90 per jaar.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    rosterPolyBreadcrumb(lang, 'Roster Polyamorie', Astro.site!),
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
---

<BaseLayout
  lang={lang}
  path={`/${ROSTER_POLY_SLUG.nl}`}
  alternates={slugAlternates(rosterPolyPath, Astro.site!)}
  title="Roster Polyamorie – de app voor al je relaties"
  description="Roster Polyamorie: de relatie-app voor iedereen die meerdere relaties bewust beheert – lokaal opgeslagen, geen account, geen tracking."
  schema={schema}
>
  <Header lang={lang} />
  <main class="rp-page">
    <section class="hero">
      <div class="container">
        <p class="eyebrow">Privacy-First · iOS</p>
        <h1>Roster Polyamorie</h1>
        <p class="lede">
          De app voor iedereen die bewust meer dan één relatie tegelijk leidt – klassiek
          polyamoor, hiërarchisch, solo-poly of in relatieanarchie. Lokaal opgeslagen, geen
          account, geen tracking.
        </p>
        <div class="hero-cta">
          <a href={APP_STORE_URL} class="btn btn-primary" rel="noopener">Download in de App Store</a>
          <a href={quizPath(lang)} class="btn btn-ghost">Doe de compatibiliteitstest</a>
        </div>
      </div>
    </section>

    <section class="why">
      <div class="container why-grid">
        <div>
          <p class="eyebrow">Geen datingapp</p>
          <h2>Roster helpt je niet met vinden, maar met leiden.</h2>
        </div>
        <div class="why-text">
          <p>
            Feeld, helloPOLY en de rest zijn goed in het vinden van nieuwe mensen. Maar zodra
            je meerdere relaties daadwerkelijk leidt, heb je iets anders nodig: een plek voor
            verbindingen, check-ins en de gevoelens ertussenin – zonder dat het aanvoelt als
            een projectmanagement-tool.
          </p>
          <p>
            Daar begint Roster. Lees een <a href="/nl/blog/app-voor-polyamore-relaties-organiseren/">eerlijke vergelijking van hoe Roster verschilt van pure datingapps</a> op de blog.
          </p>
        </div>
      </div>
    </section>

    <section class="highlights">
      <div class="container">
        <p class="eyebrow">Wat erin zit</p>
        <h2>Gebouwd voor echte polyamorie, niet voor de theorie.</h2>
        <div class="grid">
          {highlights.map((h) => (
            <a href={`/nl/features/${h.slug}/`} class="card highlight">
              {h.vio ? <Vio size={30} /> : <span class="dot" />}
              <h3>{h.name}</h3>
              <p>{h.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="shapes">
      <div class="container">
        <p class="eyebrow">Voor elke vorm van ENM</p>
        <h2>Polyamorie is geen enkel model.</h2>
        <p class="lede" style="margin-bottom:32px">
          Ethische non-monogamie (ENM) is de overkoepelende term – polyamorie, open relaties,
          relatieanarchie en solo-polyamorie zijn er allemaal vormen van. Roster past zich
          aan jouw vorm aan, niet andersom.
        </p>
        <ul class="related-list">
          {related.map((r) => (
            <li><a href={r.href}>{r.title} →</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section id="faq" class="faq">
      <div class="container faq-wrap">
        <div><p class="eyebrow">FAQ</p><h2>Veelgestelde vragen</h2></div>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="card faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="closing">
      <div class="container closing-inner">
        <Vio size={48} />
        <h2>Roster Polyamorie – klaar voor een leeg hoofd?</h2>
        <a href={APP_STORE_URL} class="btn btn-primary" rel="noopener">Download Roster in de App Store</a>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .hero { padding-top: clamp(48px, 7vw, 88px); padding-bottom: clamp(32px, 5vw, 56px); text-align: center; }
  .hero .lede { max-width: 56ch; margin-inline: auto; }
  .hero-cta { display: flex; gap: 14px; margin-top: 32px; flex-wrap: wrap; justify-content: center; }
  .why-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 40px; align-items: start; }
  .why-text p { color: var(--text-muted); line-height: 1.75; }
  .why-text a { color: var(--purple); }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 40px; }
  .highlight { color: var(--text); text-decoration: none; transition: border-color 0.2s ease, transform 0.15s ease; }
  .highlight:hover { text-decoration: none; border-color: var(--purple); transform: translateY(-3px); }
  .highlight .dot { display: block; width: 10px; height: 10px; border-radius: 50%; background: var(--purple); }
  .highlight h3 { margin-top: 16px; }
  .highlight p { color: var(--text-muted); margin: 0; font-size: 0.92rem; }
  .related-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .related-list a { display: block; padding: 16px 0; border-bottom: 1px solid var(--border); color: var(--text); font-size: 1rem; }
  .related-list a:hover { color: var(--purple); text-decoration: none; }
  .faq-wrap { display: grid; grid-template-columns: 0.6fr 1.4fr; gap: 40px; align-items: start; }
  .faq-list { display: flex; flex-direction: column; gap: 12px; }
  .faq-item { padding: 0; }
  .faq-item summary { cursor: pointer; list-style: none; padding: 20px 24px; font-weight: 500; display: flex; justify-content: space-between; align-items: center; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; color: var(--purple); font-size: 1.4rem; line-height: 1; }
  .faq-item[open] summary::after { content: '–'; }
  .faq-item p { padding: 0 24px 22px; margin: 0; color: var(--text-muted); }
  .closing-inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .closing h2 { max-width: 20ch; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .why-grid { grid-template-columns: 1fr; }
    .faq-wrap { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
