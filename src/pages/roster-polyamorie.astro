---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Vio from '../components/Vio.astro';
import { ROSTER_POLY_SLUG } from '../i18n/rosterPolyPath';
import { rosterPolyBreadcrumb } from '../i18n/breadcrumbs';
import { quizPath } from '../i18n/quizPath';

const lang = 'de';
const APP_STORE_URL = 'https://apps.apple.com/app/roster-polyamory-tracker/id6786782804';

const highlights = [
  { slug: 'polycule-map', name: 'Polycule Map', desc: 'Dein Beziehungsnetz als lebendige Karte statt als Kopf-Tabelle – du im Zentrum, alle Verbindungen farbcodiert nach Typ.' },
  { slug: 'wellness', name: 'Wellness', desc: 'STI-Tests und Check-ins im Blick, diskret und lokal – wichtig, sobald mehr als zwei Menschen involviert sind.' },
  { slug: 'reflection', name: 'Reflexion', desc: 'Ein Journal für Eifersucht, Compersion und NRE. Zum Sortieren der eigenen Gefühle, nicht zum Bewerten.' },
  { slug: 'vio', name: 'Vio', vio: true, desc: 'Dein Begleiter in der App, der nachfragt wie es dir geht – mal sanft, mal schonungslos ehrlich.' },
];

const related = [
  { title: 'Polyamorie: Was ist das? Bedeutung, Definition und die wichtigsten Grundlagen', href: '/blog/was-ist-polyamorie' },
  { title: 'Ethische Nicht-Monogamie (ENM): Definition, Formen und Abgrenzung', href: '/blog/ethische-nicht-monogamie' },
  { title: 'Polyamorie für Anfänger: Der ehrliche Einstieg', href: '/blog/polyamorie-fuer-anfaenger' },
  { title: 'Was ist ein Polycule? Beziehungsformen und Beispiele', href: '/blog/was-ist-ein-polycule' },
  { title: 'Metamour, Compersion, NRE & Co. – das große Glossar', href: '/blog/polyamorie-glossar' },
];

const faqs = [
  {
    q: 'Ist Roster nur für Polyamorie gemacht, oder auch für ENM, offene Beziehungen und Beziehungsanarchie?',
    a: 'Roster ist für jede Form ethischer Nicht-Monogamie gebaut – klassisch polyamor, hierarchisch oder nicht-hierarchisch, solo-poly, offene Beziehung oder Beziehungsanarchie. Die App legt keine Struktur fest, sie bildet ab, wie deine Beziehungen tatsächlich aussehen.',
  },
  {
    q: 'Wie unterscheidet sich Roster von einer Dating-App wie Feeld oder helloPOLY?',
    a: 'Dating-Apps helfen dir, neue Menschen zu finden. Roster setzt danach an: Es hilft dir, die Beziehungen zu führen, die du bereits hast – mit Übersicht, Check-ins und Reflexion statt Swipen.',
  },
  {
    q: 'Sind meine Daten privat?',
    a: 'Ja. Roster ist local-first: Alle Daten bleiben auf deinem Gerät. Es gibt kein Roster-Backend, kein Tracking und keine Cloud-Synchronisation, die deine Beziehungsdaten irgendwo speichert.',
  },
  {
    q: 'Was kostet Roster?',
    a: 'Die Basisfunktionen sind kostenlos. Premium gibt es für 0,99 € pro Woche, 2,99 € pro Monat (mit 3 Tagen gratis) oder 29,90 € pro Jahr.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    rosterPolyBreadcrumb(lang, 'Roster Polyamorie', Astro.site!),
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
---

<BaseLayout
  lang={lang}
  path={`/${ROSTER_POLY_SLUG.de}`}
  title="Roster Polyamorie – die App für alle deine Beziehungen"
  description="Roster Polyamorie: die Beziehungs-App für alle, die mehrere Verbindungen bewusst führen – lokal gespeichert, ohne Konto, ohne Tracking."
  schema={schema}
>
  <Header lang={lang} />
  <main class="rp-page">
    <section class="hero">
      <div class="container">
        <p class="eyebrow">Privacy-First · iOS</p>
        <h1>Roster Polyamorie</h1>
        <p class="lede">
          Die App für alle, die mehr als eine Beziehung gleichzeitig bewusst führen –
          ob klassisch polyamor, hierarchisch, solo-poly oder in Beziehungsanarchie.
          Lokal gespeichert, kein Konto, kein Tracking.
        </p>
        <div class="hero-cta">
          <a href={APP_STORE_URL} class="btn btn-primary" rel="noopener">Im App Store laden</a>
          <a href={quizPath(lang)} class="btn btn-ghost">Kompatibilitäts-Test machen</a>
        </div>
      </div>
    </section>

    <section class="why">
      <div class="container why-grid">
        <div>
          <p class="eyebrow">Keine Dating-App</p>
          <h2>Roster hilft nicht beim Finden, sondern beim Führen.</h2>
        </div>
        <div class="why-text">
          <p>
            Feeld, helloPOLY & Co. sind gut darin, neue Menschen zu finden. Aber sobald
            du mehrere Beziehungen tatsächlich führst, brauchst du etwas anderes: einen
            Ort für Verbindungen, Check-ins und die Gefühle dazwischen – ohne dass es
            sich wie ein Projektmanagement-Tool anfühlt.
          </p>
          <p>
            Genau da setzt Roster an. Ein <a href="/blog/app-poly-beziehungen-organisieren">ehrlicher Vergleich, wie sich Roster von reinen Dating-Apps unterscheidet</a>,
            steht im Blog.
          </p>
        </div>
      </div>
    </section>

    <section class="highlights">
      <div class="container">
        <p class="eyebrow">Was drinsteckt</p>
        <h2>Gebaut für echte Polyamorie, nicht für die Theorie.</h2>
        <div class="grid">
          {highlights.map((h) => (
            <a href={`/features/${h.slug}`} class="card highlight">
              {h.vio ? <Vio size={30} /> : <span class="dot" />}
              <h3>{h.name}</h3>
              <p>{h.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="shapes">
      <div class="container">
        <p class="eyebrow">Für jede Form von ENM</p>
        <h2>Polyamorie ist kein einzelnes Modell.</h2>
        <p class="lede" style="margin-bottom:32px">
          Ethische Nicht-Monogamie (ENM) ist der Oberbegriff – Polyamorie, offene
          Beziehungen, Beziehungsanarchie und Solo-Poly sind einzelne Ausprägungen davon.
          Roster passt sich deiner Form an, nicht umgekehrt.
        </p>
        <ul class="related-list">
          {related.map((r) => (
            <li><a href={r.href}>{r.title} →</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section id="faq" class="faq">
      <div class="container faq-wrap">
        <div><p class="eyebrow">FAQ</p><h2>Häufige Fragen</h2></div>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="card faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="closing">
      <div class="container closing-inner">
        <Vio size={48} />
        <h2>Roster Polyamorie – bereit für den Kopf frei?</h2>
        <a href={APP_STORE_URL} class="btn btn-primary" rel="noopener">Roster im App Store laden</a>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .hero { padding-top: clamp(48px, 7vw, 88px); padding-bottom: clamp(32px, 5vw, 56px); text-align: center; }
  .hero .lede { max-width: 56ch; margin-inline: auto; }
  .hero-cta { display: flex; gap: 14px; margin-top: 32px; flex-wrap: wrap; justify-content: center; }
  .why-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 40px; align-items: start; }
  .why-text p { color: var(--text-muted); line-height: 1.75; }
  .why-text a { color: var(--purple); }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 40px; }
  .highlight { color: var(--text); text-decoration: none; transition: border-color 0.2s ease, transform 0.15s ease; }
  .highlight:hover { text-decoration: none; border-color: var(--purple); transform: translateY(-3px); }
  .highlight .dot { display: block; width: 10px; height: 10px; border-radius: 50%; background: var(--purple); }
  .highlight h3 { margin-top: 16px; }
  .highlight p { color: var(--text-muted); margin: 0; font-size: 0.92rem; }
  .related-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .related-list a { display: block; padding: 16px 0; border-bottom: 1px solid var(--border); color: var(--text); font-size: 1rem; }
  .related-list a:hover { color: var(--purple); text-decoration: none; }
  .faq-wrap { display: grid; grid-template-columns: 0.6fr 1.4fr; gap: 40px; align-items: start; }
  .faq-list { display: flex; flex-direction: column; gap: 12px; }
  .faq-item { padding: 0; }
  .faq-item summary { cursor: pointer; list-style: none; padding: 20px 24px; font-weight: 500; display: flex; justify-content: space-between; align-items: center; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; color: var(--purple); font-size: 1.4rem; line-height: 1; }
  .faq-item[open] summary::after { content: '–'; }
  .faq-item p { padding: 0 24px 22px; margin: 0; color: var(--text-muted); }
  .closing-inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .closing h2 { max-width: 20ch; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .why-grid { grid-template-columns: 1fr; }
    .faq-wrap { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
