---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Vio from '../../components/Vio.astro';
import { ROSTER_POLY_SLUG } from '../../i18n/rosterPolyPath';
import { rosterPolyBreadcrumb } from '../../i18n/breadcrumbs';
import { quizPath } from '../../i18n/quizPath';

const lang = 'en';
const APP_STORE_URL = 'https://apps.apple.com/app/roster-polyamory-tracker/id6786782804';

const highlights = [
  { slug: 'polycule-map', name: 'Polycule Map', desc: 'Your relationship web as a living map instead of a mental spreadsheet — you at the center, every connection colour-coded by type.' },
  { slug: 'wellness', name: 'Wellness', desc: 'STI tests and check-ins in view, discreet and local — the kind of thing that matters once more than two people are involved.' },
  { slug: 'reflection', name: 'Reflection', desc: 'A journal for jealousy, compersion and NRE. To sort your own feelings, not to judge them.' },
  { slug: 'vio', name: 'Vio', vio: true, desc: 'Your companion inside the app who checks in on you — sometimes gentle, sometimes bluntly honest.' },
];

const related = [
  { title: 'What Is Polyamory? Meaning, Definition and the Basics', href: '/en/blog/what-is-polyamory/' },
  { title: 'Ethical Non-Monogamy (ENM): Definition, Types and Distinctions', href: '/en/blog/ethical-non-monogamy/' },
  { title: 'Polyamory for Beginners: An Honest Starting Point', href: '/en/blog/polyamory-for-beginners/' },
  { title: 'What Is a Polycule? Relationship Shapes and Examples', href: '/en/blog/what-is-a-polycule/' },
  { title: 'Metamour, Compersion, NRE & More — the Full Glossary', href: '/en/blog/polyamory-glossary/' },
];

const faqs = [
  {
    q: 'Is Roster only for polyamory, or also for ENM, open relationships and relationship anarchy?',
    a: 'Roster is built for any form of ethical non-monogamy — classic polyamory, hierarchical or non-hierarchical, solo poly, open relationships or relationship anarchy. The app doesn\'t impose a structure, it reflects the one your relationships actually have.',
  },
  {
    q: 'How is Roster different from a dating app like Feeld?',
    a: 'Dating apps help you find new people. Roster picks up where that ends: it helps you run the relationships you already have — with overview, check-ins and reflection instead of swiping.',
  },
  {
    q: 'Is my data private?',
    a: 'Yes. Roster is local-first: all data stays on your device. There is no Roster backend, no tracking and no cloud sync that stores your relationship data anywhere else.',
  },
  {
    q: 'What does Roster cost?',
    a: 'The basics are free. Premium is €0.99/week, €2.99/month (with a 3-day free trial) or €29.90/year.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    rosterPolyBreadcrumb(lang, 'Roster Polyamory', Astro.site!),
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
---

<BaseLayout
  lang={lang}
  path={`/${ROSTER_POLY_SLUG.en}`}
  title="Roster Polyamory & ENM – One App for Every Relationship"
  description="Roster polyamory app for people managing more than one relationship — polyamorous, ENM, solo poly or relationship anarchy. Local-first, no account, no tracking."
  schema={schema}
>
  <Header lang={lang} />
  <main class="rp-page">
    <section class="hero">
      <div class="container">
        <p class="eyebrow">Privacy-First · iOS</p>
        <h1>Roster Polyamory</h1>
        <p class="lede">
          Built for anyone who consciously manages more than one relationship at a time —
          classic polyamory, hierarchical or not, solo poly, or relationship anarchy.
          Also known as the Roster ENM app. Local-first, no account, no tracking.
        </p>
        <div class="hero-cta">
          <a href={APP_STORE_URL} class="btn btn-primary" rel="noopener">Get it on the App Store</a>
          <a href={quizPath(lang)} class="btn btn-ghost">Take the compatibility quiz</a>
        </div>
      </div>
    </section>

    <section class="why">
      <div class="container why-grid">
        <div>
          <p class="eyebrow">Not a dating app</p>
          <h2>Roster doesn't help you find people. It helps you run relationships.</h2>
        </div>
        <div class="why-text">
          <p>
            Feeld, helloPOLY and the rest are good at helping you find new people. But once
            you're actually running more than one relationship, you need something else: a
            place for connections, check-ins and the feelings in between — without it feeling
            like a project management tool.
          </p>
          <p>
            That's where Roster starts. Read an <a href="/en/blog/app-for-organizing-polyamorous-relationships/">honest comparison of how Roster differs from pure dating apps</a> on the blog.
          </p>
        </div>
      </div>
    </section>

    <section class="highlights">
      <div class="container">
        <p class="eyebrow">What's inside</p>
        <h2>Built for real polyamory, not the theory of it.</h2>
        <div class="grid">
          {highlights.map((h) => (
            <a href={`/en/features/${h.slug}/`} class="card highlight">
              {h.vio ? <Vio size={30} /> : <span class="dot" />}
              <h3>{h.name}</h3>
              <p>{h.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="shapes">
      <div class="container">
        <p class="eyebrow">For every shape of ENM</p>
        <h2>Polyamory isn't one single model.</h2>
        <p class="lede" style="margin-bottom:32px">
          Ethical non-monogamy (ENM) is the umbrella term — polyamory, open relationships,
          relationship anarchy and solo polyamory are all shapes it can take. Roster adapts
          to your shape, not the other way around.
        </p>
        <ul class="related-list">
          {related.map((r) => (
            <li><a href={r.href}>{r.title} →</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section id="faq" class="faq">
      <div class="container faq-wrap">
        <div><p class="eyebrow">FAQ</p><h2>Common questions</h2></div>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="card faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="closing">
      <div class="container closing-inner">
        <Vio size={48} />
        <h2>Roster Polyamory — ready to clear your head?</h2>
        <a href={APP_STORE_URL} class="btn btn-primary" rel="noopener">Get Roster on the App Store</a>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .hero { padding-top: clamp(48px, 7vw, 88px); padding-bottom: clamp(32px, 5vw, 56px); text-align: center; }
  .hero .lede { max-width: 56ch; margin-inline: auto; }
  .hero-cta { display: flex; gap: 14px; margin-top: 32px; flex-wrap: wrap; justify-content: center; }
  .why-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 40px; align-items: start; }
  .why-text p { color: var(--text-muted); line-height: 1.75; }
  .why-text a { color: var(--purple); }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 40px; }
  .highlight { color: var(--text); text-decoration: none; transition: border-color 0.2s ease, transform 0.15s ease; }
  .highlight:hover { text-decoration: none; border-color: var(--purple); transform: translateY(-3px); }
  .highlight .dot { display: block; width: 10px; height: 10px; border-radius: 50%; background: var(--purple); }
  .highlight h3 { margin-top: 16px; }
  .highlight p { color: var(--text-muted); margin: 0; font-size: 0.92rem; }
  .related-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .related-list a { display: block; padding: 16px 0; border-bottom: 1px solid var(--border); color: var(--text); font-size: 1rem; }
  .related-list a:hover { color: var(--purple); text-decoration: none; }
  .faq-wrap { display: grid; grid-template-columns: 0.6fr 1.4fr; gap: 40px; align-items: start; }
  .faq-list { display: flex; flex-direction: column; gap: 12px; }
  .faq-item { padding: 0; }
  .faq-item summary { cursor: pointer; list-style: none; padding: 20px 24px; font-weight: 500; display: flex; justify-content: space-between; align-items: center; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; color: var(--purple); font-size: 1.4rem; line-height: 1; }
  .faq-item[open] summary::after { content: '–'; }
  .faq-item p { padding: 0 24px 22px; margin: 0; color: var(--text-muted); }
  .closing-inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .closing h2 { max-width: 20ch; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .why-grid { grid-template-columns: 1fr; }
    .faq-wrap { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
