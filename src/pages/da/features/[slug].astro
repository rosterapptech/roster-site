---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Vio from '../../../components/Vio.astro';
import { featureData, featureSlugs, type FeatureSlug } from '../../../config/features';
import { featureBreadcrumb } from '../../../i18n/breadcrumbs';

export const prerender = true;

export function getStaticPaths() {
  return featureSlugs
    .filter((slug) => featureData['da'][slug])
    .map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const lang = 'da';
const feature = featureData[lang][slug as FeatureSlug];
if (!feature) return Astro.redirect("/");

const schema = {
  '@context': 'https://schema.org',
  '@graph': [featureBreadcrumb(lang, feature.name, slug as string, Astro.site!)],
};
---

<BaseLayout
  lang={lang}
  path={`/features/${slug}`}
  title={`${feature.name} – Roster`}
  description={feature.longDesc}
  schema={schema}
>
  <Header lang={lang} />
  <main class="container feature-page">
    <a href="/da/#features" class="back">← Tilbage til funktioner</a>

    <div class="feature-layout">
      <div class="feature-text">
        <div class="feature-header">
          {feature.vio
            ? <Vio size={56} />
            : <span class="feat-icon" set:html={feature.icon} />
          }
          <h1>{feature.name}</h1>
          <p class="tagline">{feature.shortDesc}</p>
        </div>
        <p class="long-desc">{feature.longDesc}</p>
        {feature.bullets && feature.bullets.length > 0 && (
          <ul class="feature-bullets">
            {feature.bullets.map((b) => <li>{b}</li>)}
          </ul>
        )}
        <a href="https://apps.apple.com/app/apple-store/id6786782804?pt=129111138&amp;ct=Website&amp;mt=8" class="btn btn-primary cta">Hent i App Store</a>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .feature-page { max-width: 1000px; padding-block: 60px 80px; }
  .back { color: var(--text-muted); font-size: 0.9rem; }
  .feature-layout { max-width: 640px; margin-top: 48px; }
  .feature-text { display: flex; flex-direction: column; }
  .feature-header { display: flex; flex-direction: column; gap: 12px; }
  .feat-icon { display: block; }
  .feature-header h1 { margin: 0; }
  .tagline { color: var(--text-muted); font-size: 1.1rem; margin: 0; line-height: 1.6; }
  .long-desc { color: var(--text-muted); line-height: 1.75; margin-top: 28px; font-size: 1rem; }
  .cta { margin-top: 40px; display: inline-block; align-self: flex-start; }
  @media (max-width: 720px) {
    .feature-layout { gap: 40px; }
    .cta { align-self: center; }
  }
</style>
