---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Vio from '../../components/Vio.astro';
import { ROSTER_POLY_SLUG, rosterPolyPath } from '../../i18n/rosterPolyPath';
import { slugAlternates } from '../../i18n/slugAlternates';
import { rosterPolyBreadcrumb } from '../../i18n/breadcrumbs';
import { quizPath } from '../../i18n/quizPath';

const lang = 'da';
const APP_STORE_URL = 'https://apps.apple.com/app/apple-store/id6786782804?pt=129111138&ct=Website&mt=8';

const highlights = [
  { slug: 'polycule-map', name: 'Polycule Map', desc: 'Dit forholdsnetværk som et levende kort i stedet for en liste i hovedet – dig i midten, alle forbindelser farvekodet efter type.' },
  { slug: 'wellness', name: 'Wellness', desc: 'Hold styr på STI-tests og check-ins, diskret og lokalt – vigtigt, så snart der er mere end to mennesker involveret.' },
  { slug: 'reflection', name: 'Refleksion', desc: 'En dagbog til jalousi, compersion og NRE. Til at sortere dine følelser, ikke bedømme dem.' },
  { slug: 'vio', name: 'Vio', vio: true, desc: 'Din følgesvend i appen, der spørger, hvordan du har det – nogle gange blidt, nogle gange helt ærligt.' },
];

const related = [
  { title: 'Hvad er polyamori? Betydning, definition og det grundlæggende', href: '/da/blog/hvad-er-polyamori/' },
  { title: 'Etisk ikke-monogami: definition, former og forskelle', href: '/da/blog/etisk-ikke-monogami/' },
  { title: 'Polyamori for begyndere: en ærlig start', href: '/da/blog/polyamori-for-begyndere/' },
  { title: 'Hvad er et polycule? Forholdsformer og eksempler', href: '/da/blog/hvad-er-et-polycule/' },
  { title: 'Metamour, compersion, NRE og mere – den store ordbog', href: '/da/blog/polyamori-ordbog/' },
];

const faqs = [
  {
    q: 'Er Roster kun til polyamori, eller også til etisk ikke-monogami, åbne forhold og relationsanarki?',
    a: 'Roster er bygget til enhver form for etisk ikke-monogami – klassisk polyamori, hierarkisk eller ikke-hierarkisk, solo-poly, åbent forhold eller relationsanarki. Appen dikterer ikke en struktur, den afspejler den, dine forhold allerede har.',
  },
  {
    q: 'Hvordan adskiller Roster sig fra en datingapp som Feeld?',
    a: 'Datingapps hjælper dig med at finde nye mennesker. Roster tager over derfra: det hjælper dig med at styre de forhold, du allerede har – med overblik, check-ins og refleksion i stedet for swipe.',
  },
  {
    q: 'Er mine data private?',
    a: 'Ja. Roster er local-first: alle data bliver på din enhed. Der er ingen Roster-backend, ingen tracking og ingen cloud-synkronisering, der gemmer dine forholdsdata andre steder.',
  },
  {
    q: 'Hvad koster Roster?',
    a: 'Basisfunktionerne er gratis. Premium koster 0,99 €/uge, 2,99 €/måned (med 3 dages gratis prøve) eller 29,90 €/år.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    rosterPolyBreadcrumb(lang, 'Roster Polyamori', Astro.site!),
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
---

<BaseLayout
  lang={lang}
  path={`/${ROSTER_POLY_SLUG.da}`}
  alternates={slugAlternates(rosterPolyPath, Astro.site!)}
  title="Roster Polyamori – appen til alle dine forhold"
  description="Roster Polyamori: relations-appen til dig, der har mere end ét forhold ad gangen – lokalt gemt, ingen konto, ingen tracking."
  schema={schema}
>
  <Header lang={lang} />
  <main class="rp-page">
    <section class="hero">
      <div class="container">
        <p class="eyebrow">Privacy-First · iOS</p>
        <h1>Roster Polyamori</h1>
        <p class="lede">
          Appen til dig, der bevidst har mere end ét forhold ad gangen – klassisk polyamori,
          hierarkisk, solo-poly eller relationsanarki. Lokalt gemt, ingen konto, ingen
          tracking.
        </p>
        <div class="hero-cta">
          <a href={APP_STORE_URL} class="btn btn-primary" rel="noopener">Hent i App Store</a>
          <a href={quizPath(lang)} class="btn btn-ghost">Tag kompatibilitetstesten</a>
        </div>
      </div>
    </section>

    <section class="why">
      <div class="container why-grid">
        <div>
          <p class="eyebrow">Ikke en datingapp</p>
          <h2>Roster hjælper dig ikke med at finde – men med at styre.</h2>
        </div>
        <div class="why-text">
          <p>
            Feeld, helloPOLY og resten er gode til at finde nye mennesker. Men når du rent
            faktisk styrer flere forhold, har du brug for noget andet: et sted til
            forbindelser, check-ins og følelserne indimellem – uden at det føles som et
            projektstyringsværktøj.
          </p>
          <p>
            Det er dér, Roster starter. Læs en <a href="/da/blog/app-til-at-organisere-polyamorose-forhold/">ærlig sammenligning af, hvordan Roster adskiller sig fra rene datingapps</a> på bloggen.
          </p>
        </div>
      </div>
    </section>

    <section class="highlights">
      <div class="container">
        <p class="eyebrow">Hvad er inkluderet</p>
        <h2>Bygget til rigtig polyamori, ikke til teorien.</h2>
        <div class="grid">
          {highlights.map((h) => (
            <a href={`/da/features/${h.slug}/`} class="card highlight">
              {h.vio ? <Vio size={30} /> : <span class="dot" />}
              <h3>{h.name}</h3>
              <p>{h.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="shapes">
      <div class="container">
        <p class="eyebrow">Til enhver form for etisk ikke-monogami</p>
        <h2>Polyamori er ikke én bestemt model.</h2>
        <p class="lede" style="margin-bottom:32px">
          Etisk ikke-monogami er paraplybegrebet – polyamori, åbne forhold, relationsanarki
          og solo-polyamori er alle sammen former under det. Roster tilpasser sig din form,
          ikke omvendt.
        </p>
        <ul class="related-list">
          {related.map((r) => (
            <li><a href={r.href}>{r.title} →</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section id="faq" class="faq">
      <div class="container faq-wrap">
        <div><p class="eyebrow">FAQ</p><h2>Ofte stillede spørgsmål</h2></div>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="card faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="closing">
      <div class="container closing-inner">
        <Vio size={48} />
        <h2>Roster Polyamori – klar til et roligt hoved?</h2>
        <a href={APP_STORE_URL} class="btn btn-primary" rel="noopener">Hent Roster i App Store</a>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .hero { padding-top: clamp(48px, 7vw, 88px); padding-bottom: clamp(32px, 5vw, 56px); text-align: center; }
  .hero .lede { max-width: 56ch; margin-inline: auto; }
  .hero-cta { display: flex; gap: 14px; margin-top: 32px; flex-wrap: wrap; justify-content: center; }
  .why-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 40px; align-items: start; }
  .why-text p { color: var(--text-muted); line-height: 1.75; }
  .why-text a { color: var(--purple); }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 40px; }
  .highlight { color: var(--text); text-decoration: none; transition: border-color 0.2s ease, transform 0.15s ease; }
  .highlight:hover { text-decoration: none; border-color: var(--purple); transform: translateY(-3px); }
  .highlight .dot { display: block; width: 10px; height: 10px; border-radius: 50%; background: var(--purple); }
  .highlight h3 { margin-top: 16px; }
  .highlight p { color: var(--text-muted); margin: 0; font-size: 0.92rem; }
  .related-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .related-list a { display: block; padding: 16px 0; border-bottom: 1px solid var(--border); color: var(--text); font-size: 1rem; }
  .related-list a:hover { color: var(--purple); text-decoration: none; }
  .faq-wrap { display: grid; grid-template-columns: 0.6fr 1.4fr; gap: 40px; align-items: start; }
  .faq-list { display: flex; flex-direction: column; gap: 12px; }
  .faq-item { padding: 0; }
  .faq-item summary { cursor: pointer; list-style: none; padding: 20px 24px; font-weight: 500; display: flex; justify-content: space-between; align-items: center; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; color: var(--purple); font-size: 1.4rem; line-height: 1; }
  .faq-item[open] summary::after { content: '–'; }
  .faq-item p { padding: 0 24px 22px; margin: 0; color: var(--text-muted); }
  .closing-inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .closing h2 { max-width: 20ch; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .why-grid { grid-template-columns: 1fr; }
    .faq-wrap { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
