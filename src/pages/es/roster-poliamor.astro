---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Vio from '../../components/Vio.astro';
import { ROSTER_POLY_SLUG, rosterPolyPath } from '../../i18n/rosterPolyPath';
import { slugAlternates } from '../../i18n/slugAlternates';
import { rosterPolyBreadcrumb } from '../../i18n/breadcrumbs';
import { quizPath } from '../../i18n/quizPath';

const lang = 'es';
const APP_STORE_URL = 'https://apps.apple.com/app/roster-polyamory-tracker/id6786782804';

const highlights = [
  { slug: 'polycule-map', name: 'Polycule Map', desc: 'Tu red de relaciones como un mapa vivo, no como una lista mental – tú en el centro, cada conexión coloreada según su tipo.' },
  { slug: 'wellness', name: 'Wellness', desc: 'Pruebas de ITS y check-ins a la vista, discretos y locales – importante en cuanto hay más de dos personas involucradas.' },
  { slug: 'reflection', name: 'Reflexión', desc: 'Un diario para los celos, la compersión y el NRE. Para ordenar tus emociones, no para juzgarlas.' },
  { slug: 'vio', name: 'Vio', vio: true, desc: 'Tu acompañante dentro de la app que te pregunta cómo estás – a veces suave, a veces sin rodeos.' },
];

const related = [
  { title: '¿Qué es el poliamor? Significado, definición y lo esencial', href: '/es/blog/que-es-el-poliamor/' },
  { title: 'No monogamia ética: definición, formas y diferencias', href: '/es/blog/no-monogamia-etica/' },
  { title: 'Poliamor para principiantes: un inicio honesto', href: '/es/blog/poliamoria-para-principiantes/' },
  { title: '¿Qué es un polycule? Formas de relación y ejemplos', href: '/es/blog/que-es-un-polycule/' },
  { title: 'Metamour, compersión, NRE y más – el glosario completo', href: '/es/blog/glosario-poliamoria/' },
];

const faqs = [
  {
    q: '¿Roster es solo para poliamor, o también para no monogamia ética, relaciones abiertas y anarquía relacional?',
    a: 'Roster está pensado para cualquier forma de no monogamia ética: poliamor clásico, jerárquico o no jerárquico, poliamor solo, relación abierta o anarquía relacional. La app no impone una estructura, refleja la que ya tienen tus relaciones.',
  },
  {
    q: '¿En qué se diferencia Roster de una app de citas como Feeld?',
    a: 'Las apps de citas te ayudan a conocer gente nueva. Roster empieza donde eso termina: te ayuda a llevar las relaciones que ya tienes, con visión de conjunto, check-ins y reflexión en lugar de deslizar perfiles.',
  },
  {
    q: '¿Mis datos son privados?',
    a: 'Sí. Roster es local-first: todos los datos permanecen en tu dispositivo. No hay backend de Roster, ni rastreo, ni sincronización en la nube que guarde tus datos en otro sitio.',
  },
  {
    q: '¿Cuánto cuesta Roster?',
    a: 'Las funciones básicas son gratuitas. Premium cuesta 0,99 €/semana, 2,99 €/mes (con 3 días de prueba gratis) o 29,90 €/año.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    rosterPolyBreadcrumb(lang, 'Roster Poliamor', Astro.site!),
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
---

<BaseLayout
  lang={lang}
  path={`/${ROSTER_POLY_SLUG.es}`}
  alternates={slugAlternates(rosterPolyPath, Astro.site!)}
  title="Roster Poliamor – la app para todas tus relaciones"
  description="Roster Poliamor: la app de relaciones para quienes llevan más de una relación de forma consciente – local, sin cuenta, sin rastreo."
  schema={schema}
>
  <Header lang={lang} />
  <main class="rp-page">
    <section class="hero">
      <div class="container">
        <p class="eyebrow">Privacy-First · iOS</p>
        <h1>Roster Poliamor</h1>
        <p class="lede">
          La app para quienes llevan de forma consciente más de una relación a la vez – ya
          sea poliamor clásico, jerárquico, solo-poli o anarquía relacional. Datos locales,
          sin cuenta, sin rastreo.
        </p>
        <div class="hero-cta">
          <a href={APP_STORE_URL} class="btn btn-primary" rel="noopener">Descargar en la App Store</a>
          <a href={quizPath(lang)} class="btn btn-ghost">Hacer el test de compatibilidad</a>
        </div>
      </div>
    </section>

    <section class="why">
      <div class="container why-grid">
        <div>
          <p class="eyebrow">No es una app de citas</p>
          <h2>Roster no te ayuda a encontrar, sino a llevar.</h2>
        </div>
        <div class="why-text">
          <p>
            Feeld, helloPOLY y demás son buenas para encontrar gente nueva. Pero en cuanto
            llevas varias relaciones de verdad, necesitas otra cosa: un lugar para conexiones,
            check-ins y los sentimientos que hay en medio – sin que parezca una herramienta
            de gestión de proyectos.
          </p>
          <p>
            Ahí empieza Roster. Lee una <a href="/es/blog/app-para-organizar-relaciones-poliamorosas/">comparación honesta de cómo Roster se diferencia de las apps de citas puras</a> en el blog.
          </p>
        </div>
      </div>
    </section>

    <section class="highlights">
      <div class="container">
        <p class="eyebrow">Qué incluye</p>
        <h2>Hecha para el poliamor real, no para la teoría.</h2>
        <div class="grid">
          {highlights.map((h) => (
            <a href={`/es/features/${h.slug}/`} class="card highlight">
              {h.vio ? <Vio size={30} /> : <span class="dot" />}
              <h3>{h.name}</h3>
              <p>{h.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="shapes">
      <div class="container">
        <p class="eyebrow">Para cada forma de no monogamia ética</p>
        <h2>El poliamor no es un único modelo.</h2>
        <p class="lede" style="margin-bottom:32px">
          La no monogamia ética es el término general – el poliamor, las relaciones abiertas,
          la anarquía relacional y el poliamor solo son algunas de sus formas. Roster se
          adapta a la tuya, no al revés.
        </p>
        <ul class="related-list">
          {related.map((r) => (
            <li><a href={r.href}>{r.title} →</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section id="faq" class="faq">
      <div class="container faq-wrap">
        <div><p class="eyebrow">FAQ</p><h2>Preguntas frecuentes</h2></div>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="card faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="closing">
      <div class="container closing-inner">
        <Vio size={48} />
        <h2>Roster Poliamor – ¿lista para despejar la mente?</h2>
        <a href={APP_STORE_URL} class="btn btn-primary" rel="noopener">Descargar Roster en la App Store</a>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .hero { padding-top: clamp(48px, 7vw, 88px); padding-bottom: clamp(32px, 5vw, 56px); text-align: center; }
  .hero .lede { max-width: 56ch; margin-inline: auto; }
  .hero-cta { display: flex; gap: 14px; margin-top: 32px; flex-wrap: wrap; justify-content: center; }
  .why-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 40px; align-items: start; }
  .why-text p { color: var(--text-muted); line-height: 1.75; }
  .why-text a { color: var(--purple); }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 40px; }
  .highlight { color: var(--text); text-decoration: none; transition: border-color 0.2s ease, transform 0.15s ease; }
  .highlight:hover { text-decoration: none; border-color: var(--purple); transform: translateY(-3px); }
  .highlight .dot { display: block; width: 10px; height: 10px; border-radius: 50%; background: var(--purple); }
  .highlight h3 { margin-top: 16px; }
  .highlight p { color: var(--text-muted); margin: 0; font-size: 0.92rem; }
  .related-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .related-list a { display: block; padding: 16px 0; border-bottom: 1px solid var(--border); color: var(--text); font-size: 1rem; }
  .related-list a:hover { color: var(--purple); text-decoration: none; }
  .faq-wrap { display: grid; grid-template-columns: 0.6fr 1.4fr; gap: 40px; align-items: start; }
  .faq-list { display: flex; flex-direction: column; gap: 12px; }
  .faq-item { padding: 0; }
  .faq-item summary { cursor: pointer; list-style: none; padding: 20px 24px; font-weight: 500; display: flex; justify-content: space-between; align-items: center; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; color: var(--purple); font-size: 1.4rem; line-height: 1; }
  .faq-item[open] summary::after { content: '–'; }
  .faq-item p { padding: 0 24px 22px; margin: 0; color: var(--text-muted); }
  .closing-inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .closing h2 { max-width: 20ch; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .why-grid { grid-template-columns: 1fr; }
    .faq-wrap { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
