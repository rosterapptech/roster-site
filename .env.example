# App Store Server Notifications V2 -> Telegram

# Komma-separiert, ohne Leerzeichen
APPLE_BUNDLE_IDS=de.eliasstudios.roster,EliasStudios.Spurlos--Metadaten-lo-schen

# App Store Connect -> App -> Allgemeine Informationen -> "Apple-ID"
# In Production Pflicht, in Sandbox optional.
APPLE_APP_APPLE_ID_ROSTER=
APPLE_APP_APPLE_ID_SPURLOS=

# Zufälliges Secret im Pfad, z. B. `openssl rand -hex 24`
ASN_PATH_SECRET=

# Von @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# "false" schaltet Sandbox-Events stumm (Apple bekommt trotzdem immer 200)
SEND_SANDBOX_EVENTS=true
